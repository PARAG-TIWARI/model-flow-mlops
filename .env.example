# ModelFlow MLOps Environment Variables
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ModelFlow MLOps"

# Model & Serving Settings
MODEL_PATH=artifacts/models/champion_model.joblib
METADATA_PATH=artifacts/models/model_metadata.json
REFERENCE_DATA_PATH=data/processed/train.csv

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=modelflow-customer-churn

# Monitoring & Drift Thresholds
KS_ALPHA=0.05
PSI_DRIFT_THRESHOLD=0.15
CORS_ORIGINS=["*"]
